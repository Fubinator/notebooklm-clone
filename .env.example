# Safe browser configuration. Find both values in the Supabase project's Connect dialog.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server-only. Find this in Supabase API Keys and never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=replace_me

# Server-only. Restrict the token to Workers AI Read for this Cloudflare account.
CLOUDFLARE_ACCOUNT_ID=replace_me
CLOUDFLARE_API_TOKEN=replace_me
CLOUDFLARE_ANSWER_MODEL=@cf/meta/llama-3.1-8b-instruct-fast

# Server-only Retrieval tuning. Defaults are shown for the six-Passage Example corpus.
RETRIEVAL_MATCH_COUNT=5
RETRIEVAL_MIN_SIMILARITY=0.42

# Reviewer limits. Keep these visible in the UI and enforce them on the server.
NOTEBOOKS_PER_GUEST=5
SOURCES_PER_NOTEBOOK=5
CONCURRENT_INGESTIONS_PER_GUEST=1
QUESTIONS_PER_GUEST_PER_UTC_DAY=20
PASTED_TEXT_CHARACTER_LIMIT=50000
PDF_BYTE_LIMIT=10485760
PDF_PAGE_LIMIT=50
PASSAGE_TARGET_CHARACTERS=900
PASSAGE_OVERLAP_CHARACTERS=150

# Total successful model Answers allowed for this deployment. Set to 0 to
# pause new Questions without hiding existing Notebooks, Sources, or Answers.
DEPLOYMENT_QUESTION_HARD_CEILING=1000

# CI browser access for a protected Vercel deployment. Never use or expose the
# reviewer/share URL; configure Vercel's dedicated automation bypass secret.
VERCEL_AUTOMATION_BYPASS_SECRET=replace_me
